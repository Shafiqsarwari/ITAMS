<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AssetInventoryAgent</AssemblyName>
    <RootNamespace>AssetInventoryAgent</RootNamespace>
    <AssemblyTitle>IT Asset Maintenance Management System Agent</AssemblyTitle>
    <Product>IT Asset Maintenance Management System Agent</Product>
    <Company>IT Asset Maintenance Management System</Company>
    <Version>1.2.13</Version>
  </PropertyGroup>
</Project>
